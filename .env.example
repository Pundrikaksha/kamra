# Required for live search. Leave empty to run demo mode.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. Use another Gemini model id if Google renames it.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Google Programmable Search JSON API. Both values are required to use it.
# Results are still limited to listing-site hosts.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
